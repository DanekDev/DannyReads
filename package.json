{
  "name": "md-reader",
  "version": "1.0.0",
  "description": "Markdown Reader & Editor for macOS",
  "main": "main.js",
  "scripts": {
    "build:editor": "esbuild src/editor/index.js --bundle --format=iife --outfile=editor-bundle.js --platform=browser --target=chrome128",
    "start": "npm run build:editor && electron .",
    "prebuild": "npm run build:editor",
    "build": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.1",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.41.1",
    "chokidar": "^3.6.0",
    "highlight.js": "^11.11.0",
    "marked": "^15.0.0",
    "mermaid": "^11.13.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "esbuild": "^0.28.0"
  },
  "build": {
    "appId": "com.dannyreads.app",
    "productName": "DannyReads",
    "files": [
      "**/*",
      "!src/editor${/*}",
      "editor-bundle.js"
    ],
    "extraResources": [
      {
        "from": "vendor/",
        "to": "vendor/"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": [
            "md",
            "markdown",
            "mdown"
          ],
          "name": "Markdown Document",
          "role": "Editor"
        },
        {
          "ext": [
            "puml",
            "plantuml",
            "pu",
            "wsd"
          ],
          "name": "PlantUML Document",
          "role": "Editor"
        }
      ]
    }
  }
}
